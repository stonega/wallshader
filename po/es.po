msgid "Flood C"
msgstr "Relleno C"

#: po/paper-catalog.js:161
msgid "Flood K"
msgstr "Relleno K"

#: po/paper-catalog.js:162
msgid "Flood M"
msgstr "Relleno M"

#: po/paper-catalog.js:163
msgid "Flood Y"
msgstr "Relleno Y"

#: po/paper-catalog.js:164
msgid "Fluorescent"
msgstr "Fluorescente"

#: po/paper-catalog.js:165
msgid "Fluted Glass"
