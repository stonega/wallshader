msgid "Color behind the paper sheet in RGBA"
msgstr "Color detrás de la hoja de papel en RGBA"

#: po/paper-catalog.js:84
msgid ""
"Color gradient added over image and background, following distortion shape, "
"needs colorShadow alpha > 0 (0 to 1)"
msgstr ""
"Degradado de color sobre la imagen y el fondo que sigue la forma de "
"distorsión; requiere alfa de colorShadow > 0 (0 a 1)"

#: po/paper-catalog.js:85
msgid "Color highlight on the panels edges"
msgstr "Realce de color en los bordes de los paneles"

#: po/paper-catalog.js:86
msgid ""
"Color mixing within a panel, 0 = solid, 1 = gradient, needs 2+ colors (0 to "
"1)"
msgstr ""
"Mezcla de colores dentro de un panel; 0 = sólido, 1 = degradado; requiere al "
"menos 2 colores (0 a 1)"

#: po/paper-catalog.js:87
msgid "Color of the paper sheet in RGBA"
msgstr "Color de la hoja de papel en RGBA"

#: po/paper-catalog.js:88
msgid "Color of the patterns over the paper sheet in RGBA"
msgstr "Color de los patrones sobre la hoja de papel en RGBA"

#: po/paper-catalog.js:89
msgid "Color overlay blended with the rays in RGBA, needs bloom > 0"
msgstr "Color superpuesto mezclado con los rayos en RGBA; requiere bloom > 0"

#: po/paper-catalog.js:90
msgid "Color spots placement seed (0 to 100)"
msgstr "Semilla de distribución de las manchas de color (0 a 100)"

#: po/paper-catalog.js:91
msgid "Color tint for radial inner shadow inside cells in RGBA, needs glow > 0"
msgstr ""
"Tinte de la sombra interior radial de las celdas en RGBA; requiere glow > 0"

#: po/paper-catalog.js:92
msgid "Color transition sharpness, 0 = hard edge, 1 = smooth gradient (0 to 1)"
msgstr ""
"Suavizado de la transición de color; 0 = borde nítido, 1 = degradado suave "
"(0 a 1)"

#: po/paper-catalog.js:93
msgid ""
"Color transition sharpness, 0 = hard edge, 1 = smooth gradient, needs 2+ "
"colors (0 to 1)"
msgstr ""
"Suavizado de la transición de color; 0 = borde nítido, 1 = degradado suave; "
"requiere al menos 2 colores (0 a 1)"

#: po/paper-catalog.js:94
msgid "Color used for cell borders/gaps in RGBA"
msgstr "Color de los bordes o espacios entre celdas en RGBA"

#: po/paper-catalog.js:95
msgid ""
"Coloring added over image/background following caustic shape, needs "
"colorHighlight alpha > 0 (0 to 1)"
msgstr ""
"Color sobre la imagen o el fondo que sigue la forma cáustica; requiere alfa "
"de colorHighlight > 0 (0 a 1)"

#: po/paper-catalog.js:96 src/catalog.js:60
msgid "Contour"
msgstr "Contorno"

#: po/paper-catalog.js:97
msgid "Contrast"
msgstr "Contraste"

#: po/paper-catalog.js:98
msgid ""
"Contrast applied to the sampled image, at 0 the luminance is flat so all the "
"dots get equal size (0 to 1)"
msgstr ""
"Contraste aplicado a la imagen muestreada; en 0 la luminancia es uniforme y "
"todos los puntos tienen el mismo tamaño (0 a 1)"

#: po/paper-catalog.js:99
msgid "Count"
msgstr "Cantidad"

#: po/paper-catalog.js:100
msgid "Creased"
msgstr "Plegado"

#: po/paper-catalog.js:101
msgid "Cross Section"
msgstr "Sección transversal"

#: po/paper-catalog.js:102
msgid "Crumple Count"
msgstr "Número de arrugas gruesas"

#: po/paper-catalog.js:103
msgid "Crumple-like facets repeating across the surface (0 to 1)"
msgstr "Facetas de papel arrugado que se repiten por la superficie (0 a 1)"

#: po/paper-catalog.js:104
msgid "Crumples"
msgstr "Arrugas gruesas"

#: po/paper-catalog.js:105
msgid "Curly thread-like noise covering the surface evenly (0 to 1)"
msgstr "Ruido de hebras rizadas que cubre la superficie uniformemente (0 a 1)"

#: po/paper-catalog.js:106
msgid "Cuts the paper sheet to the image frame, needs image"
msgstr "Recorta la hoja de papel al marco de la imagen; requiere una imagen"

#: po/paper-catalog.js:107
msgid "Cyan ink color in RGBA"
msgstr "Color de tinta cian en RGBA"

#: po/paper-catalog.js:108
msgid "Default"
msgstr "Predeterminado"

#: po/paper-catalog.js:109
msgid "Density"
msgstr "Densidad"

#: po/paper-catalog.js:110
msgid "Density of pattern stripes (1 to 10)"
msgstr "Densidad de las rayas del patrón (1 a 10)"

#: po/paper-catalog.js:111
msgid "Direction of pattern animation in degrees (0 to 360)"
msgstr "Dirección de animación del patrón en grados (0 a 360)"

#: po/paper-catalog.js:112
msgid "Direction of the grid relative to the image in degrees (0 to 180)"
msgstr "Dirección de la cuadrícula respecto a la imagen en grados (0 a 180)"

#: po/paper-catalog.js:113
msgid ""
"Direction of the heatwaves in degrees, needs innerGlow or outerGlow > 0 (0 "
"to 360)"
msgstr ""
"Dirección de las ondas de calor en grados; requiere innerGlow u outerGlow > "
"0 (0 a 360)"

#: po/paper-catalog.js:114
msgid ""
"Direction of the spread in degrees, needs spread > 0, perspective < 1 (0 to "
"360)"
msgstr ""
"Dirección de expansión en grados; requiere spread > 0 y perspective < 1 (0 a "
"360)"

#: po/paper-catalog.js:115
msgid ""
"Direction the surface is lit from in degrees, also the roughness rows "
"direction, needs crumples, wrinkles, folds, roughnessRows or drops > 0 (0 to "
"360)"
msgstr ""
"Dirección de iluminación de la superficie en grados y de las filas de "
"rugosidad; requiere crumples, wrinkles, folds, roughnessRows o drops > 0 (0 "
"a 360)"

