#: data/io.github.wallshader.Wallshader.desktop:2
msgid "Wallshader"
msgstr "Wallshader"

#: data/io.github.wallshader.Wallshader.desktop:3
msgid "Make your desktop a little more colorful"
msgstr "Dale un poco más de color a tu escritorio"

#: data/io.github.wallshader.Wallshader.desktop:9
