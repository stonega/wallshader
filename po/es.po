msgid "Distortion between color bands (0 to 1)"
msgstr "Distorsión entre las bandas de color (0 a 1)"

#: po/paper-catalog.js:129
msgid "Dithering"
msgstr "Tramado"

#: po/paper-catalog.js:130
msgid ""
"Dithering type (1 = random, 2 = 2x2 Bayer, 3 = 4x4 Bayer, 4 = 8x8 Bayer)"
msgstr ""
