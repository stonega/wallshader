msgid "Color Mid"
msgstr "Color intermedio"

#: po/paper-catalog.js:76
msgid "Color Panels"
msgstr "Paneles de color"

#: po/paper-catalog.js:77
msgid "Color Paper"
msgstr "Color del papel"

#: po/paper-catalog.js:78
msgid "Color Shadow"
msgstr "Color de sombra"

