#: po/paper-catalog.js:45
msgid "Bloom"
msgstr "Fulgor"

#: po/paper-catalog.js:46
msgid "Blur"
msgstr "Desenfoque"

#: po/paper-catalog.js:47
msgid "Border base width (0 to 1)"
msgstr "Anchura base del borde (0 a 1)"

#: po/paper-catalog.js:48
msgid "Border edge sharpness, 0 = hard edge, 1 = smooth gradient (0 to 1)"
msgstr "Suavizado del borde; 0 = borde nítido, 1 = degradado suave (0 a 1)"

#: po/paper-catalog.js:49
msgid "Border radius (0 to 1)"
msgstr "Radio del borde (0 a 1)"

#: po/paper-catalog.js:50
msgid "Brightness"
msgstr "Brillo"

#: po/paper-catalog.js:51
msgid "Brightness/intensity of the central glow, needs midSize > 0 (0 to 1)"
msgstr ""
"Brillo o intensidad del resplandor central; requiere midSize > 0 (0 a 1)"

#: po/paper-catalog.js:52
msgid "Bubblegum"
msgstr "Chicle"

#: po/paper-catalog.js:53
