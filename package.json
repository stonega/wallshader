{
  "name": "wallshader",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "description": "Native GNOME wallpapers made with Paper Shaders",
  "scripts": {
    "build": "bun scripts/build.js && bun scripts/build-extension.js",
    "build:extension": "bun run build",
    "package": "./scripts/package.sh",
    "start": "./scripts/run.sh",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "test:native": "./scripts/test-native.sh",
    "test:kitty": "bun scripts/test-kitty.js",
    "test:shell": "./scripts/test-shell.sh",
    "test:kitty:render": "./scripts/test-kitty-render.sh"
  },
  "dependencies": {
    "@paper-design/shaders": "0.0.81"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6"
  }
}
