{
  "$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!!build",
      "!!build-native",
      "!!build-flatpak",
      "!!.flatpak-builder",
      "!!artifacts",
      "!!dist",
      "!!data/third-party",
      "!!data/style.css",
      "!!po/paper-catalog.js"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true, "style": { "useImportType": "off" } }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "overrides": [
    {
      "includes": ["packaging/flatpak/*.json"],
      "formatter": { "indentWidth": 4 }
    },
    {
      "includes": ["src/renderer/renderer.js", "scripts/sync-paper.js"],
      "linter": {
        "rules": { "performance": { "noDynamicNamespaceImportAccess": "off" } }
      }
    }
  ]
}
