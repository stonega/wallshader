msgid "Angle between every 2 panels (0.25 to 7)"
msgstr "Ángulo entre cada par de paneles (0.25 a 7)"

#: po/paper-catalog.js:18
msgid "Angle of the focal point in degrees, needs focalDistance > 0 (0 to 360)"
msgstr "Ángulo del punto focal en grados; requiere focalDistance > 0 (0 a 360)"

#: po/paper-catalog.js:19
msgid "Angle1"
msgstr "Ángulo 1"

#: po/paper-catalog.js:20
msgid "Angle2"
msgstr "Ángulo 2"

#: po/paper-catalog.js:21
msgid "Angular size of spots (0 to 1)"
msgstr "Tamaño angular de las manchas (0 a 1)"

#: po/paper-catalog.js:22
msgid "Aspect Ratio"
msgstr "Relación de aspecto"

#: po/paper-catalog.js:23
msgid "Aspect ratio mode (0 = auto, 1 = square)"
msgstr "Modo de relación de aspecto (0 = automático, 1 = cuadrado)"

#: po/paper-catalog.js:24
msgid "B-channel dispersion (-1 to 1)"
msgstr "Dispersión del canal B (-1 a 1)"

#: po/paper-catalog.js:25
msgid "Backdrop"
msgstr "Trasfondo"

#: po/paper-catalog.js:26
msgid "Background"
msgstr "Fondo"

#: po/paper-catalog.js:27
msgid "Background (paper) color in RGBA"
msgstr "Color de fondo del papel en RGBA"

#: po/paper-catalog.js:28
msgid "Background color in RGBA"
msgstr "Color de fondo en RGBA"

#: po/paper-catalog.js:29
msgid "Background color in RGBA, needs originalColors off"
msgstr "Color de fondo en RGBA; requiere originalColors desactivado"

#: po/paper-catalog.js:30
msgid ""
"Balance of the dispersion between a soft circular zone at the centre and the "
"rest of the image; 0 applies it evenly, -1 keeps it in the centre only, 1 "
"keeps it at the edges only, needs spread > 0, dispersion > 0 (-1 to 1)"
msgstr ""
"Equilibrio de dispersión entre una zona circular suave en el centro y el "
"resto de la imagen; 0 la aplica uniformemente, -1 la limita al centro y 1 la "
"limita a los bordes; requiere spread > 0 y dispersion > 0 (-1 a 1)"

#: po/paper-catalog.js:31
msgid "Band Count"
msgstr "Número de bandas"

#: po/paper-catalog.js:32
msgid "Base pattern type (0 = checks, 1 = stripes, 2 = edge)"
msgstr "Tipo de patrón base (0 = cuadros, 1 = rayas, 2 = borde)"

#: po/paper-catalog.js:33
msgid "Base size of each shape in pixels (1 to 100)"
msgstr "Tamaño base de cada forma en píxeles (1 a 100)"

#: po/paper-catalog.js:34
msgid "Beach"
msgstr "Playa"

#: po/paper-catalog.js:35
msgid "Bias"
msgstr "Sesgo"

#: po/paper-catalog.js:36
msgid "Black ink color in RGBA"
msgstr "Color de tinta negra en RGBA"

#: po/paper-catalog.js:37
msgid "Blend point between colors, 0.5 = equal distribution (0 to 1)"
msgstr "Punto de mezcla entre colores; 0.5 = distribución uniforme (0 a 1)"

#: po/paper-catalog.js:38
msgid ""
"Blend point between front and back colors, 0.5 = equal distribution (0 to 1)"
msgstr ""
"Punto de mezcla entre los colores frontal y de fondo; 0.5 = distribución "
"uniforme (0 a 1)"

#: po/paper-catalog.js:39
msgid "Blend point between two colors, 0.5 = equal distribution (0 to 1)"
msgstr "Punto de mezcla entre dos colores; 0.5 = distribución uniforme (0 a 1)"

#: po/paper-catalog.js:40
msgid "Blending"
msgstr "Mezcla"

#: po/paper-catalog.js:41
msgid ""
"Blending behavior, 0 = hard stripes, 0.5 = smooth, 1 = gradual blend (0 to 1)"
msgstr ""
"Comportamiento de mezcla; 0 = rayas nítidas, 0.5 = suave, 1 = mezcla gradual "
"(0 a 1)"

#: po/paper-catalog.js:42
msgid "Blending behavior, 0 = hard stripes, 1 = smooth gradient (0 to 1)"
msgstr ""
"Comportamiento de mezcla; 0 = rayas nítidas, 1 = degradado suave (0 a 1)"

#: po/paper-catalog.js:43
msgid "Blob"
msgstr "Masa"

#: po/paper-catalog.js:44
